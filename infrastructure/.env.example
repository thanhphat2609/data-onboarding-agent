# Copy to infrastructure/.env (gitignored) and fill in what you need. All optional.
# Shell env vars (e.g. Codespaces secrets) win over values in this file.

# Model: tunnel URL + key from the Colab notebook (step 4).
# Default when empty: Ollama on the host machine (http://host.docker.internal:11434)
OLLAMA_HOST=
OLLAMA_API_KEY=
# Empty = rule-based (no LLM)
OLLAMA_MODEL=

# The agent reads data-onboarding-ingestion and data-onboarding-transformation from GitHub.
# Fine-grained token with Contents: Read-only on both repos.
# Codespaces presets GITHUB_TOKEN for its own repo only, and a shell variable wins over this file:
# there, run `export GITHUB_TOKEN=<your token>` before docker compose.
GITHUB_TOKEN=
# Other repos or branches (defaults shown)
INGESTION_REPO=thanhphat2609/data-onboarding-ingestion
INGESTION_REF=main
TRANSFORMATION_REPO=thanhphat2609/data-onboarding-transformation
TRANSFORMATION_REF=main

# Empty = Teams messages are written to outputs/<request_id>/teams_messages.jsonl
TEAMS_WEBHOOK_URL=

# Key the Data Team enters to open the "Data Team review" tab (approve / request changes).
# Empty = the tab is open to everyone (fine for a solo demo).
REVIEWER_KEY=

# 0 = no web research for sources the platform can't onboard yet
WEB_RESEARCH=1

# Headless Chromium for web research: Bing/Brave search and JavaScript-only pages (~400 MB in the image).
# Changing it needs a rebuild: docker compose -f infrastructure/compose.yaml up -d --build
WITH_BROWSER=false

# Host port for the UI (container port is always 7860)
UI_PORT=7860
