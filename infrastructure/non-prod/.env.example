# Copy to infrastructure/non-prod/.env (gitignored) and fill in what you need. All optional.
# Shell env vars (e.g. Codespaces secrets) win over values in this file.

# Model: tunnel URL + key from the Colab notebook (step 4).
# Default when empty: Ollama on the host machine (http://host.docker.internal:11434)
OLLAMA_HOST=
OLLAMA_API_KEY=
# Empty = rule-based (no LLM)
OLLAMA_MODEL=

# The agent reads data-onboarding-ingestion and data-onboarding-transformation from GitHub.
# Fine-grained token with Contents: Read-only on both repos. PLATFORM_GITHUB_TOKEN wins over GITHUB_TOKEN.
# Codespaces: GITHUB_TOKEN is preset for the codespace's own repo only and beats this file. Add
# PLATFORM_GITHUB_TOKEN as a Codespaces secret instead (GitHub → Settings → Codespaces → Secrets).
PLATFORM_GITHUB_TOKEN=
GITHUB_TOKEN=
# Other repos or branches (defaults shown)
INGESTION_REPO=thanhphat2609/data-onboarding-ingestion
INGESTION_REF=main
TRANSFORMATION_REPO=thanhphat2609/data-onboarding-transformation
TRANSFORMATION_REF=main

# Empty = Teams messages are written to outputs/<request_id>/teams_messages.jsonl
TEAMS_WEBHOOK_URL=

# Web UI login: user:password pairs, comma-separated (or ACCOUNTS_FILE, one pair per line).
# Usually just the Data Team, e.g. ACCOUNTS=data.team@gmail.com:<password>. Any other email is a requester and
# self-registers: its first sign-in sets its password. Empty = no login page, everyone sees every tab.
ACCOUNTS=
# Accounts with full access (Data Team review, Settings, Debug, every session). Everyone else is a requester.
DATA_TEAM=data.team@gmail.com

# 0 = no web research for sources the platform can't onboard yet
WEB_RESEARCH=1

# Headless Chromium for web research: Bing/Brave search and JavaScript-only pages (~400 MB in the image).
# Changing it needs a rebuild: docker compose -f infrastructure/non-prod/docker-compose.yml up -d --build
WITH_BROWSER=false

# Host port for the UI (container port is always 7860)
UI_PORT=7860

# PostgreSQL, the platform's one server: database onboarding_agent (this app), airflow (Airflow metadata) and
# platform (ingestion run records). Read only on the FIRST start, when the pgdata volume is empty. URL-safe characters only.
# Defaults: postgres / agent / airflow / platform. data-onboarding-ingestion's .env must repeat the last two as
# AIRFLOW_DB_PASSWORD / PLATFORM_DB_PASSWORD.
POSTGRES_PASSWORD=
POSTGRES_AGENT_PASSWORD=
POSTGRES_AIRFLOW_PASSWORD=
POSTGRES_PLATFORM_PASSWORD=
# Host port (localhost only), default 5432
POSTGRES_PORT=5432