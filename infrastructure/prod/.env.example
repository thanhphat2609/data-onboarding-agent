# Prod on VM 1: the full list of settings. The Deploy workflow writes infrastructure/prod/.env on the VM from the
# repository secret or variable of the same name (render_env.py); don't edit .env on the VM, it's replaced on every
# deploy. Values below are examples only. __GENERATE__ = required secret. Setup: infrastructure/prod/README.md.

# --- Secrets (Settings -> Secrets and variables -> Actions -> Secrets) ---

# PostgreSQL roles, read only on the first start (empty pgdata volume); changing one later also needs
# ALTER ROLE ... PASSWORD on the server. URL-safe characters only.
# data-onboarding-ingestion's AIRFLOW_DB_PASSWORD secret must equal POSTGRES_AIRFLOW_PASSWORD.
# POSTGRES_PASSWORD = superuser (admin only); PLATFORM = ingestion's run history, empty until its Phase 5.
# Why four roles: docs/POSTGRESQL.md#roles-and-passwords
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_AGENT_PASSWORD=__GENERATE__
POSTGRES_AIRFLOW_PASSWORD=__GENERATE__
POSTGRES_PLATFORM_PASSWORD=__GENERATE__

# Fine-grained token, Contents: Read-only on data-onboarding-ingestion and data-onboarding-transformation.
PLATFORM_GITHUB_TOKEN=__GENERATE__

# Data Team logins (user:password, comma-separated); requesters self-register.
ACCOUNTS=__GENERATE__

# Any random string; SearXNG (web research search) signs its cookies with it.
SEARXNG_SECRET=__GENERATE__

# Optional secrets: the Prod channel's Teams workflow URL (empty = messages written to outputs/), the model's API key.
TEAMS_WEBHOOK_URL=
OLLAMA_API_KEY=

# --- Variables (same page -> Variables tab) ---

# Required: the Data Team's login(s), comma-separated (same emails as in ACCOUNTS).
DATA_TEAM=data.team@example.com

# Optional; empty = the default in docker-compose.yml.
OLLAMA_HOST=
OLLAMA_MODEL=
UI_PORT=7860
POSTGRES_PORT=5432
WEB_RESEARCH=1
WEBSEARCH_BROWSER=auto
WITH_BROWSER=false
SEARXNG_URL=
INGESTION_REPO=
INGESTION_REF=
TRANSFORMATION_REPO=
TRANSFORMATION_REF=
